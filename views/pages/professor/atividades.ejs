<%- include('../../partials/head') %>

<body>
    <%- include('../../partials/navbar') %>

    <div class="container py-5">
        <div class="mb-3">
            <a href="/professor" class="btn btn-outline-primary">
                <i class="fa fa-arrow-left me-2"></i>Voltar
            </a>
        </div>

        <h1 class="mb-4 text-center">Atividades</h1>

        <!-- Botão para adicionar nova atividade -->
        <div class="d-flex justify-content-end mb-4">
            <button class="btn btn-primary" id="btnNovaAtividade">
                <i class="fa fa-plus me-2"></i>Nova Atividade
            </button>
        </div>

        <!-- Lista de atividades -->
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 text-white">Minhas Atividades</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Turma</th>
                                <th>Disciplina</th>
                                <th>Data de Entrega</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabelaAtividades">
                            <tr>
                                <td colspan="5" class="text-center">
                                    <i class="fa fa-spinner fa-spin"></i> Carregando...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para criar/editar atividade -->
    <div class="modal fade" id="modalAtividade" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title text-white" id="modalAtividadeLabel">Nova Atividade</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formAtividade">
                        <input type="hidden" id="atividadeId">
                        <div class="mb-3">
                            <label for="titulo" class="form-label">Título</label>
                            <input type="text" class="form-control" id="titulo" name="titulo" required>
                        </div>
                        <div class="mb-3">
                            <label for="descricao" class="form-label">Descrição</label>
                            <textarea class="form-control" id="descricao" name="descricao" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="turma" class="form-label">Turma</label>
                            <select class="form-select" id="turma" name="turma" required>
                                <option value="">Selecione uma turma</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="disciplina" class="form-label">Disciplina</label>
                            <select class="form-select" id="disciplina" name="disciplina" required>
                                <option value="">Selecione uma disciplina</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="dataEntrega" class="form-label">Data de Entrega</label>
                            <input type="date" class="form-control" id="dataEntrega" name="dataEntrega" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnSalvarAtividade">
                        <i class="fa fa-save me-2"></i>Salvar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../../partials/footer') %>

    <script>
        let todasTurmasDisciplinas = [];
        let modalAtividade = null;

        document.addEventListener('DOMContentLoaded', () => {
            modalAtividade = new bootstrap.Modal(document.getElementById('modalAtividade'));
            
            carregarTurmasEDisciplinas();
            carregarAtividades();
            configurarEventListeners();
            configurarDataMinima();
        });

        function configurarEventListeners() {
            document.getElementById('btnNovaAtividade').addEventListener('click', abrirModalNovo);
            document.getElementById('btnSalvarAtividade').addEventListener('click', salvarAtividade);
            document.getElementById('turma').addEventListener('change', function() {
                popularDisciplinasPorTurma(this.value);
            });
        }

        function configurarDataMinima() {
            const inputData = document.getElementById('dataEntrega');
            inputData.min = getDataHoje();
        }

        function getDataHoje() {
            const hoje = new Date();
            return hoje.toISOString().split('T')[0];
        }

        function formatarDataParaInput(dataISO) {
            if (!dataISO) return '';
            return dataISO.split('T')[0];
        }

        async function carregarTurmasEDisciplinas() {
            try {
                //URL atualizada
                const response = await fetch('/professor/api/atividades/turmas-disciplinas');
                const data = await response.json();

                if (data.sucesso && data.turmas?.length > 0) {
                    todasTurmasDisciplinas = data.turmas;
                    popularTurmas();
                } else {
                    document.getElementById('turma').innerHTML = '<option disabled>Nenhuma turma encontrada</option>';
                    document.getElementById('disciplina').innerHTML = '<option disabled>Nenhuma disciplina encontrada</option>';
                }
            } catch (error) {
                console.error('Erro ao carregar turmas e disciplinas:', error);
            }
        }

        function popularTurmas() {
            const turmaSelect = document.getElementById('turma');
            
            // Extrair turmas únicas
            const turmasMap = new Map();
            todasTurmasDisciplinas.forEach(item => {
                if (!turmasMap.has(item.id_turma)) {
                    turmasMap.set(item.id_turma, item.nome_turma);
                }
            });

            turmaSelect.innerHTML = '<option value="">Selecione uma turma</option>';
            turmasMap.forEach((nome, id) => {
                turmaSelect.innerHTML += `<option value="${id}">${nome}</option>`;
            });
        }

        function popularDisciplinasPorTurma(id_turma) {
            const disciplinaSelect = document.getElementById('disciplina');
            disciplinaSelect.innerHTML = '<option value="">Selecione uma disciplina</option>';

            if (!id_turma) return;

            // Filtra disciplinas da turma e remove duplicatas
            const disciplinasMap = new Map();
            todasTurmasDisciplinas
                .filter(item => item.id_turma == id_turma)
                .forEach(item => {
                    if (!disciplinasMap.has(item.id_disciplina)) {
                        disciplinasMap.set(item.id_disciplina, item.nome_disciplina);
                    }
                });

            disciplinasMap.forEach((nome, id) => {
                disciplinaSelect.innerHTML += `<option value="${id}">${nome}</option>`;
            });
        }

        async function carregarAtividades() {
            const tabela = document.getElementById('tabelaAtividades');
            tabela.innerHTML = '<tr><td colspan="5" class="text-center"><i class="fa fa-spinner fa-spin"></i> Carregando...</td></tr>';

            try {
                //URL atualizada
                const response = await fetch('/professor/api/atividades');
                const data = await response.json();

                if (data.sucesso && data.dados?.length > 0) {
                    tabela.innerHTML = '';
                    data.dados.forEach(atividade => {
                        const dataEntrega = new Date(atividade.data_entrega).toLocaleDateString('pt-BR');
                        tabela.innerHTML += `
                            <tr>
                                <td>${atividade.titulo}</td>
                                <td>${atividade.nome_turma}</td>
                                <td>${atividade.nome_disciplina}</td>
                                <td>${dataEntrega}</td>
                                <td>
                                    <button class="btn btn-sm btn-warning" onclick="editarAtividade(${atividade.id_atividade})">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="excluirAtividade(${atividade.id_atividade})">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    tabela.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Nenhuma atividade encontrada</td></tr>';
                }
            } catch (error) {
                console.error('Erro ao carregar atividades:', error);
                tabela.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Erro ao carregar atividades</td></tr>';
            }
        }

        function abrirModalNovo() {
            document.getElementById('formAtividade').reset();
            document.getElementById('atividadeId').value = '';
            document.getElementById('modalAtividadeLabel').textContent = 'Nova Atividade';
            document.getElementById('disciplina').innerHTML = '<option value="">Selecione uma disciplina</option>';
            configurarDataMinima();
            modalAtividade.show();
        }

        async function editarAtividade(id) {
            try {
                //URL atualizada
                const response = await fetch(`/professor/api/atividades/${id}`);
                const data = await response.json();

                if (data.sucesso) {
                    const atividade = data.dados;

                    document.getElementById('atividadeId').value = atividade.id_atividade;
                    document.getElementById('titulo').value = atividade.titulo;
                    document.getElementById('descricao').value = atividade.descricao || '';
                    document.getElementById('turma').value = atividade.id_turma;
                    
                    popularDisciplinasPorTurma(atividade.id_turma);
                    
                    // Aguarda um tick para o select ser populado
                    setTimeout(() => {
                        document.getElementById('disciplina').value = atividade.id_disciplina;
                    }, 50);
                    
                    document.getElementById('dataEntrega').value = formatarDataParaInput(atividade.data_entrega);
                    document.getElementById('modalAtividadeLabel').textContent = 'Editar Atividade';
                    
                    configurarDataMinima();
                    modalAtividade.show();
                } else {
                    alert('Erro ao carregar atividade: ' + data.erro);
                }
            } catch (error) {
                console.error('Erro ao carregar atividade:', error);
                alert('Erro ao carregar atividade');
            }
        }

        async function salvarAtividade() {
            const id = document.getElementById('atividadeId').value;
            const titulo = document.getElementById('titulo').value.trim();
            const descricao = document.getElementById('descricao').value.trim();
            const id_turma = document.getElementById('turma').value;
            const id_disciplina = document.getElementById('disciplina').value;
            const data_entrega = document.getElementById('dataEntrega').value;

            // Validações
            if (!titulo || !id_turma || !id_disciplina || !data_entrega) {
                alert('Preencha todos os campos obrigatórios.');
                return;
            }

            if (data_entrega < getDataHoje()) {
                alert('A data de entrega deve ser de hoje ou futura.');
                return;
            }

            const body = { titulo, descricao, id_turma, id_disciplina, data_entrega };
            const btn = document.getElementById('btnSalvarAtividade');
            
            try {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i>Salvando...';

                let response;
                if (id) {
                    //URL atualizada - Edição
                    response = await fetch(`/professor/api/atividades/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                } else {
                    //URL atualizada - Criação
                    response = await fetch('/professor/api/atividades', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                }

                const data = await response.json();

                if (data.sucesso) {
                    alert(id ? 'Atividade atualizada com sucesso!' : 'Atividade criada com sucesso!');
                    modalAtividade.hide();
                    carregarAtividades();
                } else {
                    alert('Erro: ' + data.erro);
                }
            } catch (error) {
                console.error('Erro ao salvar atividade:', error);
                alert('Erro ao salvar atividade');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-save me-2"></i>Salvar';
            }
        }

        async function excluirAtividade(id) {
            if (!confirm('Tem certeza que deseja excluir esta atividade?\nTodas as entregas associadas também serão excluídas.')) {
                return;
            }

            try {
                //URL atualizada
                const response = await fetch(`/professor/api/atividades/${id}`, { 
                    method: 'DELETE' 
                });
                const data = await response.json();

                if (data.sucesso) {
                    alert('Atividade excluída com sucesso!');
                    carregarAtividades();
                } else {
                    alert('Erro ao excluir: ' + data.erro);
                }
            } catch (error) {
                console.error('Erro ao excluir atividade:', error);
                alert('Erro ao excluir atividade');
            }
        }
    </script>
</body>
</html>